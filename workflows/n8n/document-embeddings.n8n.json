      }
    },
    {
      "id": "2e89db53-0a27-4d14-8a63-3eb6ec3734b5",
      "name": "Varsle admin om feil",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        450
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.folkets-meninger.no/api/ops/n8n-notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{ $('Error notify settings').item.json.cronSecret }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: \"error\", subject: $(\"Format workflow error\").item.json.subject, text: $(\"Format workflow error\").item.json.text, meta: $(\"Format workflow error\").item.json.meta }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
