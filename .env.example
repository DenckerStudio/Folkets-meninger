# Supabase (required for auth, forum, votes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron jobs — protected by CRON_SECRET header (x-cron-secret)
# Scheduled via n8n workflow workflows/n8n/app-cron.workflow.ts (not Vercel Cron; Hobby plan has no cron)
CRON_SECRET=

# n8n webhooks
N8N_AI_SUMMARY_WEBHOOK_URL=
# Forum Reels v12: prompt generator (schedule + optional manual replay)
N8N_FORUM_SYNTHESIS_WEBHOOK_URL=https://n8n.heyklever.app/webhook/folkets-forum-prompt-generator
# Forum Reels v12: Regjeringen RSS ingest (manual trigger only; schedule runs in n8n)
N8N_FORUM_RSS_WEBHOOK_URL=https://n8n.heyklever.app/webhook/folkets-forum-regjeringen-rss

# Forum admin (comma-separated emails)
FORUM_ADMIN_EMAILS=

# Email (notifications, welcome)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stortinget API defaults
STORTINGET_SESSION_ID=2025-2026
STORTINGET_PERIODE_ID=2021-2025
NEXT_PUBLIC_STORTINGET_SESSION_ID=2025-2026
NEXT_PUBLIC_STORTINGET_PERIODE_ID=2021-2025

# Dev only
DISABLE_HMR=
