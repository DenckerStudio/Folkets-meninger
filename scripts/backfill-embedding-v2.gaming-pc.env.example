# Gaming-PC worker (background lane only) — placeholders only. Copy locally; never commit secrets.
#
# Chat/query embeddings stay on Ollama :11435 (EMBED_QUERY_URL). This file does not touch Ollama embed :11434.
#
# Load before run, e.g.:
#   set -a && source scripts/backfill-embedding-v2.gaming-pc.env.example && set +a

SUPABASE_URL=https://supabase.example.invalid
SUPABASE_SERVICE_ROLE_KEY=

# Ollama bge-m3 query side (preflight cosine reference) — typically LAN :11435
EMBED_QUERY_URL=http://192.168.50.154:11435

# LM Studio OpenAI-compatible embeddings on this machine (local or tunnel)
EMBED_BACKFILL_PROVIDER=lmstudio
EMBED_BACKFILL_URL=http://127.0.0.1:1234/v1
EMBED_BACKFILL_MODEL=bge-m3
EMBED_BACKFILL_MODEL_TAG=bge-m3:Q8_0 (gpustack GGUF, lmstudio)

# API key ONLY via env (never in argv or JSON body in logs)
LMSTUDIO_API_KEY=

# Optional stable worker label (hostname+pid used if unset)
EMBED_BACKFILL_WORKER_ID=gaming-pc

# Single background worker — server primary owns fast lane + main throughput
EMBED_BACKFILL_ENDPOINTS=[{"name":"gaming-pc","provider":"lmstudio","url":"http://127.0.0.1:1234/v1","lanes":["background"],"batch":16,"apiKeyEnv":"LMSTUDIO_API_KEY"}]
