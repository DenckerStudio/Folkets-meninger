{
  "id": "folkets-document-embeddings",
  "name": "Folkets Stemme – dokument embeddings (RAG)",
  "nodes": [
    {
      "id": "bf1cf99a-9a8f-4ca1-9857-789ee34fdf57",
      "name": "Every 60 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      }
    },
    {
      "id": "9ad25af3-38a0-491e-938c-aea4b983b86a",
      "name": "Embedding settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "8",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "d95196a0-60b1-4a05-b913-d4de22e795f8",
      "name": "Fetch pending chunks",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "document_chunks",
        "returnAll": false,
        "limit": "={{ Number($json.batchLimit || 8) }}",
        "filterType": "string",
        "filterString": "={{ \"embedding_status=eq.pending&order=created_at.asc\" + ($json.issueId ? \"&issue_id=eq.\" + $json.issueId : \"\") }}"
      },
      "credentials": {}
    },
    {
      "id": "87728688-60ee-4763-8b8c-c61f173f0f1f",
      "name": "Ollama embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "<__PLACEHOLDER_VALUE__https://ollama.example.com/api/embeddings__>",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"nomic-embed-text:v1.5\",\"prompt\":{{ JSON.stringify($json.content) }}}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "6f41bd03-028a-47b6-b1ff-0513f6be4941",
      "name": "Map embedding vector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const chunk = $('Fetch pending chunks').item.json;\nconst response = $input.item.json;\nconst embedding = response.embedding;\nif (!Array.isArray(embedding) || embedding.length === 0) {\n  throw new Error('Missing embedding vector');\n}\nreturn { json: { ...chunk, embedding } };"
      }
    },
    {
      "id": "e29bd12a-affe-49ab-9b86-37e3cb259011",
      "name": "Save embedding",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "document_chunks",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "embedding",
              "fieldValue": "={{ $json.embedding }}"
            },
            {
              "fieldId": "embedding_status",
              "fieldValue": "ready"
            }
          ]
        }
      },
      "credentials": {}
    },
    {
      "id": "b85d389b-9d66-4295-8403-35b5ec5a8c72",
      "name": "Clear document body storage",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "rpc/n8n_finalize_document_embedding",
        "returnAll": true,
        "filterType": "string",
        "filterString": "={{ \"p_issue_id=\" + encodeURIComponent($json.issue_id) + \"&p_document_id=\" + encodeURIComponent($json.document_id) }}"
      },
      "credentials": {}
    },
    {
      "id": "5417fe8a-4b4c-4b96-9d7c-edcd913d5f49",
      "name": "Rate limit pause",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "399078e0-b4ae-4ec6-b8e3-131c9599de66",
      "name": "Batch run complete",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1700,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "value": "embedding_batch_complete",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "c66133cf-bc16-4508-be0a-d04a82487e50",
      "name": "Webhook document embeddings",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "folkets-document-embeddings",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "8f562b84-73b6-4468-97f3-0c3afd10d944"
    },
    {
      "id": "58a8b0af-d781-4421-8e1b-6f1988e75154",
      "name": "Normalize webhook payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        450
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "12",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "={{ $json.body?.stortinget_issue_id || $json.stortinget_issue_id || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every 60 minutes": {
      "main": [
        [
          {
            "node": "Embedding settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embedding settings": {
      "main": [
        [
          {
            "node": "Fetch pending chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch pending chunks": {
      "main": [
        [
          {
            "node": "Ollama embeddings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama embeddings": {
      "main": [
        [
          {
            "node": "Map embedding vector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map embedding vector": {
      "main": [
        [
          {
            "node": "Save embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save embedding": {
      "main": [
        [
          {
            "node": "Clear document body storage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clear document body storage": {
      "main": [
        [
          {
            "node": "Rate limit pause",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate limit pause": {
      "main": [
        [
          {
            "node": "Batch run complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook document embeddings": {
      "main": [
        [
          {
            "node": "Normalize webhook payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize webhook payload": {
      "main": [
        [
          {
            "node": "Fetch pending chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}