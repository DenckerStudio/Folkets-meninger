{
  "id": "folkets-document-embeddings",
  "name": "Folkets Meninger – dokument embeddings (RAG)",
  "nodes": [
    {
      "id": "55a11469-e09b-44ff-bf5b-3ac872e35bb5",
      "name": "Every 60 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "eac9e0c0-4b2b-49f1-8800-171db33140fd",
      "name": "Embedding settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "8",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "8c67fb23-8020-4224-a148-1d63e3d3a7e4",
      "name": "Fetch pending chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://supabase.heyklever.app/rest/v1/rpc/n8n_list_pending_document_chunks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_issue_id: $json.issueId || null, p_limit: Number($json.batchLimit || 8) }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {},
      "retryOnFail": true
    },
    {
      "id": "b1eef7bc-ab3e-49ea-8c17-bb1a1df6fec1",
      "name": "Expand pending chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first()?.json;\nlet rows = [];\nif (Array.isArray(raw)) rows = raw;\nelse if (Array.isArray(raw?.data)) rows = raw.data;\nelse if (raw && typeof raw === 'object' && (raw.id || raw.issue_id) && !raw.skip) rows = [raw];\nelse {\n  const all = $input.all().map((i) => i.json).filter(Boolean);\n  if (all.length && all.every((r) => r && (r.id || r.issue_id) && !Array.isArray(r))) rows = all;\n}\nrows = rows.filter((r) => r && (r.id || r.issue_id) && !r.skip && !r.outcome);\nif (!rows.length) return [];\nreturn rows.map((r) => ({ json: r }));"
      }
    },
    {
      "id": "ee4ed0d9-503b-40cd-971c-63e2842bcac7",
      "name": "Has pending chunk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "looseTypeValidation": true,
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-id",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "ff8e039f-2fb1-476b-a05e-33d9ebd1569a",
      "name": "Ollama embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"nomic-embed-text:v1.5\",\"prompt\":{{ JSON.stringify($json.content) }}}",
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "dc3705d0-b0a6-47b2-a937-668db69111bc",
      "name": "Map embedding vector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const chunk = $('Expand pending chunks').item.json;\nconst response = $input.item.json;\nconst embedding = response.embedding;\nif (!Array.isArray(embedding) || embedding.length === 0) {\n  return {\n    json: {\n      ...chunk,\n      skip: true,\n      outcome: 'embed_failed',\n      reason: 'missing_embedding_vector',\n      message: 'Ollama returned no embedding; chunk left pending for /api/cron/n8n-retry',\n    },\n  };\n}\nreturn { json: { ...chunk, embedding } };"
      }
    },
    {
      "id": "85bf3bb4-7ab9-49bc-ba73-1302ace4b6a1",
      "name": "Prepare embedding update SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nif (item.skip || item.outcome === 'embed_failed' || item.outcome === 'empty_queue') {\n  return { json: item };\n}\nconst embedding = item.embedding;\nif (!Array.isArray(embedding) || embedding.length === 0) {\n  return {\n    json: {\n      ...item,\n      skip: true,\n      outcome: 'embed_failed',\n      reason: 'missing_embedding_vector',\n    },\n  };\n}\nreturn {\n  json: {\n    ...item,\n    embedding_vector: '[' + embedding.join(',') + ']',\n  },\n};"
      }
    },
    {
      "id": "28d0c3f0-517e-4d99-98db-c55ce873d42f",
      "name": "Has embedding vector?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1700,
        300
      ],
      "parameters": {
        "looseTypeValidation": true,
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-vec",
              "leftValue": "={{ $json.embedding_vector }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "4f389265-2bc0-43b9-8c69-100d970bc88f",
      "name": "Save embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://supabase.heyklever.app/rest/v1/rpc/n8n_save_document_embedding",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_chunk_id: $json.id, p_embedding: $json.embedding_vector }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {},
      "retryOnFail": true
    },
    {
      "id": "cbb4fce0-ffa4-4142-8c98-52bf8a36f4c9",
      "name": "Clear document body storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://supabase.heyklever.app/rest/v1/rpc/n8n_finalize_document_storage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_issue_id: $('Prepare embedding update SQL').item.json.issue_id, p_document_id: $('Prepare embedding update SQL').item.json.document_id }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {},
      "onError": "continueRegularOutput"
    },
    {
      "id": "8efadadd-d498-4d8f-99fd-c61c8adc9dc0",
      "name": "Collect ready issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ids = new Set();\ntry {\n  for (const item of $('Prepare embedding update SQL').all()) {\n    const issueId = String(item.json?.issue_id || '').trim();\n    if (issueId && !item.json?.skip) ids.add(issueId);\n  }\n} catch (_) {\n  for (const item of $input.all()) {\n    const issueId = String(item.json?.issue_id || '').trim();\n    if (issueId) ids.add(issueId);\n  }\n}\nif (!ids.size) return [];\nreturn [...ids].map((stortinget_issue_id) => ({ json: { stortinget_issue_id } }));"
      }
    },
    {
      "id": "1de54b26-08fc-40c7-a92d-dc060f1f3041",
      "name": "Trigger AI summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://n8n.heyklever.app/webhook/folkets-ai-summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stortinget_issue_id: $json.stortinget_issue_id }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {},
      "onError": "continueRegularOutput"
    },
    {
      "id": "0dd30f6c-cc56-426f-9543-7efdf5c094fa",
      "name": "Rate limit pause",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2700,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "5dc56819-0599-4a45-9931-e37ff9f2e28d",
      "name": "Batch run complete",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2900,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "value": "embedding_batch_complete",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "6f7d29e2-b6ab-48fc-8a78-d49140c90042",
      "name": "Log embed failure keep pending",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1900,
        450
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "outcome",
              "name": "outcome",
              "value": "embed_failed",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "Embedding failed; chunk remains pending for next run",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "2edae567-dffd-4372-995f-14f2503bead0",
      "name": "Log empty embedding queue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        450
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "outcome",
              "name": "outcome",
              "value": "empty_queue",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "No pending document_chunks to embed",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "d6549f66-5db7-45e4-bb55-ad5f68cda802",
      "name": "Webhook document embeddings",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "folkets-document-embeddings",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "e1a06c5f-55d9-4f81-aa14-2d48a9929a18"
    },
    {
      "id": "05df1d77-20fc-4810-a056-7b9fa95b5cef",
      "name": "Normalize webhook payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        450
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "12",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "={{ $json.body?.stortinget_issue_id || $json.stortinget_issue_id || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "height": 300,
        "width": 400,
        "content": "## Dokument embeddings (RAG)\\n\\nPending chunks → Ollama `nomic-embed-text:v1.5` → pgvector. Chunking skjer i appen (`lib/document-chunking.ts`): ~800–1000 tokens (~3500 tegn), 15 % overlapp, `metadata.section_title`. Re-chunk når `content_hash` endres; deretter webhook eller timeplan.\\n\\nWebhook: `POST /webhook/folkets-document-embeddings` med valgfri `{ \"stortinget_issue_id\": \"…\" }`."
      },
      "id": "sticky-note-node",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -320,
        80
      ]
    },
    {
      "id": "82976e5d-8d7b-4ee5-a64a-35dcf9cdcef6",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        600
      ],
      "parameters": {}
    },
    {
      "id": "9dea137e-c8ad-4ad6-bfe4-16217e29d391",
      "name": "Format workflow error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first()?.json || {};\nconst workflowName = item.workflow?.name || item.workflowName || 'ukjent workflow';\nconst workflowId = item.workflow?.id || item.workflowId || '';\nconst executionId = item.execution?.id || item.executionId || '';\nconst executionUrl = item.execution?.url || (executionId ? ('https://n8n.heyklever.app/execution/' + executionId) : '');\nconst lastNode = item.lastNodeExecuted || item.node?.name || '';\nconst message = item.error?.message || item.message || 'Ukjent feil';\nconst subject = 'n8n-feil: ' + workflowName;\nconst text = [\n  'Workflow: ' + workflowName,\n  workflowId ? 'ID: ' + workflowId : null,\n  lastNode ? 'Siste node: ' + lastNode : null,\n  executionUrl ? 'Kjøring: ' + executionUrl : null,\n  '',\n  message,\n].filter(Boolean).join('\\n');\nreturn [{ json: { subject, text, meta: { workflowName, workflowId, executionId, executionUrl, lastNode } } }];"
      }
    },
    {
      "id": "b6bf61c5-c641-40fd-a685-d74dc21e9530",
      "name": "Error notify settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        600
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "cron-secret",
              "name": "cronSecret",
              "type": "string",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "59684305-9bdb-40a5-b7ca-cf0dc7202f76",
      "name": "Varsle admin om feil",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        600
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.folkets-meninger.no/api/ops/n8n-notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{ $('Error notify settings').item.json.cronSecret }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: \"error\", subject: $(\"Format workflow error\").item.json.subject, text: $(\"Format workflow error\").item.json.text, meta: $(\"Format workflow error\").item.json.meta }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
