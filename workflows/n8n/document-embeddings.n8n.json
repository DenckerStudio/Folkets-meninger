{
  "id": "folkets-document-embeddings",
  "name": "Folkets Stemme – dokument embeddings (RAG)",
  "nodes": [
    {
      "id": "ba26fb63-859b-4ce6-bccd-907b4d85603a",
      "name": "Every 60 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      }
    },
    {
      "id": "623841d0-da9c-42cc-add6-4eb3604c76fe",
      "name": "Embedding settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "8",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "c8127225-8f80-4a36-ad9c-cbe9debfce2f",
      "name": "Fetch pending chunks",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        500,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "document_chunks",
        "returnAll": false,
        "limit": "={{ Number($json.batchLimit || 8) }}",
        "filterType": "string",
        "filterString": "={{ \"embedding_status=eq.pending&order=created_at.asc\" + ($json.issueId ? \"&issue_id=eq.\" + $json.issueId : \"\") }}"
      },
      "credentials": {}
    },
    {
      "id": "977a64b6-09a7-4bbd-8126-c8abec3350e9",
      "name": "Ollama embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "<__PLACEHOLDER_VALUE__https://ollama.example.com/api/embeddings__>",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"nomic-embed-text:v1.5\",\"prompt\":{{ JSON.stringify($json.content) }}}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "ba5f651a-655b-4008-be37-9789182c65d2",
      "name": "Map embedding vector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const chunk = $('Fetch pending chunks').item.json;\nconst response = $input.item.json;\nconst embedding = response.embedding;\nif (!Array.isArray(embedding) || embedding.length === 0) {\n  throw new Error('Missing embedding vector');\n}\nreturn { json: { ...chunk, embedding } };"
      }
    },
    {
      "id": "12bf6f8e-7310-4d0b-b457-a03ed238b2c3",
      "name": "Save embedding",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "document_chunks",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "embedding",
              "fieldValue": "={{ $json.embedding }}"
            },
            {
              "fieldId": "embedding_status",
              "fieldValue": "ready"
            }
          ]
        }
      },
      "credentials": {}
    },
    {
      "id": "4efe8dca-f66f-46b0-90ae-69ea102aaed2",
      "name": "Clear document body storage",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "rpc/n8n_finalize_document_embedding",
        "returnAll": true,
        "filterType": "string",
        "filterString": "={{ \"p_issue_id=\" + encodeURIComponent($json.issue_id) + \"&p_document_id=\" + encodeURIComponent($json.document_id) }}"
      },
      "credentials": {}
    },
    {
      "id": "34056413-7f0d-47c6-aae6-bb715517e3b0",
      "name": "Rate limit pause",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "7317b600-5378-4d5a-8254-2f4d96ff24dd",
      "name": "Batch run complete",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1700,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "value": "embedding_batch_complete",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "3f7e05e6-15cc-4e14-b820-e5192ed5673c",
      "name": "Webhook document embeddings",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "folkets-document-embeddings",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "fbf77c40-f54b-44bc-91d5-936a79d15441"
    },
    {
      "id": "135e5cc0-689f-4039-90c4-790cf312886b",
      "name": "Normalize webhook payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        450
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "12",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "={{ $json.body?.stortinget_issue_id || $json.stortinget_issue_id || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every 60 minutes": {
      "main": [
        [
          {
            "node": "Embedding settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embedding settings": {
      "main": [
        [
          {
            "node": "Fetch pending chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch pending chunks": {
      "main": [
        [
          {
            "node": "Ollama embeddings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama embeddings": {
      "main": [
        [
          {
            "node": "Map embedding vector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Map embedding vector": {
      "main": [
        [
          {
            "node": "Save embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save embedding": {
      "main": [
        [
          {
            "node": "Clear document body storage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clear document body storage": {
      "main": [
        [
          {
            "node": "Rate limit pause",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rate limit pause": {
      "main": [
        [
          {
            "node": "Batch run complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook document embeddings": {
      "main": [
        [
          {
            "node": "Normalize webhook payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize webhook payload": {
      "main": [
        [
          {
            "node": "Fetch pending chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}