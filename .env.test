# Test / local self-hosted Supabase (heyklever)
# Used by Playwright, CI build, and local `npm run env:test`.
# Anon key is safe to commit (browser-exposed). Do NOT put service_role here.

NEXT_PUBLIC_SUPABASE_URL=https://supabase.heyklever.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc4NTkyNTI2MCwiZXhwIjo0OTQxNTk4ODYwLCJyb2xlIjoiYW5vbiJ9.FCdvrpnNYflrR3lKJ1XZ5pCDQZ-Tky7FkHbjgeZ7hm0

# Optional for local Docker Supabase (`npx supabase start`) — uncomment to override:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `npx supabase status`>

# Server-only — set in your shell / secrets manager, never commit:
# SUPABASE_SERVICE_ROLE_KEY=

# Stortinget defaults (needed for app routes)
STORTINGET_SESSION_ID=2025-2026
STORTINGET_PERIODE_ID=2021-2025
NEXT_PUBLIC_STORTINGET_SESSION_ID=2025-2026
NEXT_PUBLIC_STORTINGET_PERIODE_ID=2021-2025

FORUM_REELS_PUBLIC=false
