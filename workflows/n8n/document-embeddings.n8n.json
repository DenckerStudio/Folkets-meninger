    {
      "id": "b73acdcf-166a-4113-b11f-d904603e7b89",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        450
      ],
      "parameters": {}
