# Supabase
# Production / test: set your hosted project values.
# Test defaults: copy from `.env.test` via `npm run env:test`
#   (Folkets-Stemme → https://qetckokgtzbpunbzslfp.supabase.co).
# Local Docker: `npx supabase start` then use URL/keys from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron jobs — protected by CRON_SECRET header (x-cron-secret)
# Scheduled via n8n workflow workflows/n8n/app-cron.workflow.ts (not Vercel Cron; Hobby plan has no cron)
CRON_SECRET=

# n8n webhooks
N8N_AI_SUMMARY_WEBHOOK_URL=
N8N_DOCUMENT_EMBEDDINGS_WEBHOOK_URL=
N8N_HEARING_INNSPILL_WEBHOOK_URL=
N8N_SYSTEM_POLL_DRAFT_WEBHOOK_URL=

# Site admin is DB RBAC (`user_roles` / `is_admin()`), not env emails.
# Bootstrap first admin in SQL:
#   SELECT public.grant_app_role_by_email('you@example.com', 'admin', NULL);

# Email (notifications, welcome)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stortinget API defaults
STORTINGET_SESSION_ID=2025-2026
STORTINGET_PERIODE_ID=2025-2029
NEXT_PUBLIC_STORTINGET_SESSION_ID=2025-2026
NEXT_PUBLIC_STORTINGET_PERIODE_ID=2025-2029

# Dev only
DISABLE_HMR=

# Stemme+ (Stripe) — optional until checkout is enabled
# Create a recurring NOK price in Stripe Dashboard (e.g. 59 kr/mnd) and paste the Price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STEMME_PLUS_PRICE_ID=
