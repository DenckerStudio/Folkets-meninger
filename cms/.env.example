PAYLOAD_SECRET=
SERVER_URL=https://cms.folkets-meninger.no
PAYLOAD_SCHEMA=payload
WEB_PUBLIC_URL=https://www.folkets-meninger.no
WEB_REVALIDATE_URL=https://www.folkets-meninger.no/api/revalidate/blog
REVALIDATE_SECRET=
BLOG_PUBLISHED_WEBHOOK_URL=
BLOG_WEBHOOK_SIGNING_SECRET=
