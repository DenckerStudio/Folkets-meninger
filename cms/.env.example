# SEED_ON_BOOT=true
MEDIA_LOCAL_DIR=/data/media
# Optional S3-compatible storage (Supabase Storage)
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=eu-central-1
# S3_FORCE_PATH_STYLE=true
# One-off seed (do not keep password in env after seed)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
