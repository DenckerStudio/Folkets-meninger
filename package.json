{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "env:test": "node scripts/use-test-env.mjs",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "clean": "next clean",
    "eval:rag:db": "npx tsx evals/rag/scripts/apply-migrations.ts stack && npx tsx evals/rag/scripts/apply-migrations.ts baseline",
    "eval:rag:fixture": "npx tsx evals/rag/scripts/fetch-fixture-snapshot.ts",
    "eval:rag:seed": "RAG_EVAL_VARIANT=baseline npx tsx evals/rag/scripts/seed-corpus.ts && RAG_EVAL_VARIANT=stack npx tsx evals/rag/scripts/seed-corpus.ts",
    "eval:rag:analyze": "npx tsx evals/rag/scripts/analyze-eval-failures.ts",
    "eval:rag": "npx tsx evals/rag/run-eval.ts",
    "eval:rag:rounds": "npx tsx evals/rag/run-improvement-rounds.ts",
    "eval:rag:hillclimb": "npx tsx evals/rag/run-continuous-hillclimb.ts",
    "eval:rag:judge": "npx tsx evals/rag/judge.ts",
    "eval:rag:metrics": "npx tsx evals/rag/metrics.ts",
    "eval:rag:answers": "npx tsx evals/rag/export-answers.ts",
    "eval:rag:answers:v2": "npx tsx evals/rag/export-answers-v2.ts",
    "eval:rag:calibrate": "npx tsx evals/rag/scripts/calibrate-rejection.ts",
    "eval:rag:v2:manifest": "npx tsx evals/rag/scripts/build-v2-distractor-manifest.ts",
    "eval:rag:v2:seed": "RAG_EVAL_DATASET=v2 RAG_EVAL_VARIANT=stack npx tsx evals/rag/scripts/seed-corpus.ts",
    "eval:rag:v2": "RAG_EVAL_DATASET=v2 npx tsx evals/rag/run-eval-v2.ts",
    "eval:rag:v2:harness": "RAG_EVAL_V2_FAST_CI=1 npx tsx evals/rag/run-v2-harness.ts",
    "eval:rag:v2:full": "npx tsx evals/rag/run-v2-full-harness.ts",
    "eval:rag:v2:compare": "npx tsx evals/rag/run-v2-compare-harness.ts",
    "eval:rag:v2:baseline": "npx tsx evals/rag/run-v2-baseline-eval-only.ts",
    "eval:rag:run6": "npx tsx evals/rag/scripts/run-faithfulness-run6.ts",
    "typecheck:evals": "tsc -p tsconfig.evals.json",
    "check:n8n-workflows": "npx tsx scripts/check-document-embeddings-workflow-json.mjs",
    "test:unit": "npm run check:n8n-workflows && node scripts/run-unit-tests.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.90",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.130",
    "@ai-sdk/xai": "^4.0.59",
    "@base-ui/react": "^1.5.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.1",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@paper-design/shaders-react": "^0.0.78",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "ai": "^7.0.127",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.35.2",
    "next": "^15.5.28",
    "nodemailer": "^10.2.1",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.1",
    "shadcn": "^4.8.2",
    "stripe": "^23.0.0",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@n8n/workflow-sdk": "^0.9.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "supabase": "^2.58.5",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
