# Sekundær Ollama-worker (kun background lane) — placeholders. Kopier lokalt; aldri committ hemmeligheter.
#
# Chat/spørringsembeddings forblir på EMBED_QUERY_URL (:11435). Samme Ollama-instans kan backfille
# når busy-pause er på (standard når URL deler :11435).
#
# Load før kjøring, f.eks.:
#   set -a && source scripts/backfill-embedding-v2.gaming-pc.env.example && set +a

SUPABASE_URL=https://supabase.example.invalid
SUPABASE_SERVICE_ROLE_KEY=

# Ollama bge-m3 query-side (preflight cosine-referanse)
EMBED_QUERY_URL=http://<ollama-host>:11435

EMBED_BACKFILL_PROVIDER=ollama
EMBED_BACKFILL_URL=http://<ollama-host>:11435
EMBED_BACKFILL_MODEL=bge-m3
EMBED_BACKFILL_MODEL_TAG=bge-m3

# Valgfri stabil worker-etikett (hostname+pid brukes hvis utelatt)
EMBED_BACKFILL_WORKER_ID=secondary-ollama

# Én background-worker — primary eier fast lane
EMBED_BACKFILL_ENDPOINTS=[{"name":"secondary-ollama","provider":"ollama","url":"http://<ollama-host>:11435","lanes":["background"],"batch":16}]
