# Supabase
# Production / test: set your hosted project values.
# Test defaults: copy from `.env.test` via `npm run env:test`
#   (Folkets Meninger → https://qetckokgtzbpunbzslfp.supabase.co).
# Local Docker: `npx supabase start` then use URL/keys from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never commit. Create in Supabase Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Cron jobs — protected by CRON_SECRET header (x-cron-secret)
# Scheduled via n8n workflow workflows/n8n/app-cron.workflow.ts (not Vercel Cron; Hobby plan has no cron)
CRON_SECRET=

# n8n webhooks
N8N_AI_SUMMARY_WEBHOOK_URL=
# Statisk Header Auth for X-FM-Webhook-Token på folkets-ai-summary (samme verdi som n8n «FM AI Summary Webhook Token»; aldri logg)
N8N_AI_SUMMARY_WEBHOOK_TOKEN=
N8N_DOCUMENT_EMBEDDINGS_WEBHOOK_URL=
# Legacy nomic embedding retry from app cron / admin catch-up (default off; v2 backfill owns the queue)
N8N_RETRY_LEGACY_EMBEDDINGS=false
N8N_HEARING_INNSPILL_WEBHOOK_URL=
N8N_SYSTEM_POLL_DRAFT_WEBHOOK_URL=
N8N_PIPELINE_HEALTH_WEBHOOK_URL=
# Research (admin /dashboard/admin/research) — signert webhook til n8n
N8N_RESEARCH_WEBHOOK_BASE=
# HMAC for X-FM-Signature (ikke samme verdi som TOKEN under)
N8N_RESEARCH_WEBHOOK_SECRET=
# Statisk Header Auth for X-FM-Webhook-Token (egen verdi; aldri logg)
N8N_RESEARCH_WEBHOOK_TOKEN=
# Blog / Payload CMS (fm-web reads published content; publish webhook runs on fm-cms)
CMS_URL=
CMS_API_KEY=
CMS_AGENT_API_KEY=
REVALIDATE_SECRET=
# Dedicated HMAC for fm-cms → POST /api/ops/content-feedback (required on fm-web and fm-cms)
CMS_CONTENT_FEEDBACK_WEBHOOK_SECRET=

# Site admin is DB RBAC (`user_roles` / `is_admin()`), not env emails.
# Bootstrap first admin in SQL:
#   SELECT public.grant_app_role_by_email('you@example.com', 'admin', NULL);

# Email (notifications, welcome)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stortinget API defaults
STORTINGET_SESSION_ID=2025-2026
STORTINGET_PERIODE_ID=2025-2029
NEXT_PUBLIC_STORTINGET_SESSION_ID=2025-2026
NEXT_PUBLIC_STORTINGET_PERIODE_ID=2025-2029

# Dev only
DISABLE_HMR=

# Stemme+ / BYOK AI-chat
# AES-256 key: 64 hex chars (`openssl rand -hex 32`), or any passphrase (scrypt-derived).
# Required to save user LLM keys. Set the same value on Coolify/Vercel; never commit it.
BYOK_ENCRYPTION_KEY=
# Comma-separated origins admins may use for private Ollama/BYOK URLs (Stemme+). Empty = no private URLs for anyone.
# Example: http://ollama.lan.example:11434
BYOK_PRIVATE_URL_ALLOWLIST=
# Kildesøk for Stemme+-chat (SearXNG). Påkrevd i produksjon.
# Example: http://searxng.lan.example:8080
SEARXNG_BASE_URL=
# Central bge-m3 query embedding for hybrid RAG (P5). Server-only; required on fm-web prod.
# Without it, hybrid search stays lexical-only (one server log per process).
# POST {EMBED_QUERY_URL}/api/embed — example: http://embed.lan.example:11435
EMBED_QUERY_URL=
# Cross-encoder rerank (Ollama /api/rerank). No localhost fallback. Used only when RAG_RERANKER_ENABLED=1.
# Falls back to OLLAMA_BASE_URL when RERANKER_URL is empty. Example: http://ollama.lan.example:11434
RERANKER_URL=
# Default off (unset or not 1/true). Set to 1 on fm-web prod when rerank should run (requires RERANKER_URL or OLLAMA_BASE_URL).
# RAG_RERANKER_ENABLED=
# Optional; default bge-m3
EMBED_QUERY_MODEL=bge-m3
# Central hybrid query embed timeout (ms). Default 800. Separate from BYOK Ollama nomic timeout.
EMBED_QUERY_TIMEOUT_MS=800
# Coolify one-off scripts/backfill-embedding-v2.ts (service_role). See README § embedding_v2 backfill.
# lmstudio: full OpenAI-compatible base URL (proxy to LM Studio). Required — no default host/port.
# EMBED_BACKFILL_URL=
# EMBED_BACKFILL_PROVIDER=lmstudio
# EMBED_BACKFILL_MODEL=bge-m3
# EMBED_BACKFILL_MODEL_TAG=bge-m3:Q8_0 (gpustack GGUF, lmstudio)
# Multi-endpoint JSON: apiKeyEnv = env var NAME only (never put secrets in JSON).
# EMBED_BACKFILL_ENDPOINTS=
# EMBED_LMSTUDIO_SERVER_KEY=
# EMBED_LMSTUDIO_PC_KEY=
# BYOK overlay: Ollama nomic-embed-text query timeout (ms). Default 3000 for slow LAN setups.
BYOK_OLLAMA_VECTOR_TIMEOUT_MS=3000
# When true, scales BYOK timeout up slightly for longer queries (capped by BYOK_OLLAMA_VECTOR_TIMEOUT_MS).
BYOK_OLLAMA_VECTOR_TIMEOUT_ADAPTIVE=false
# Public app origin (Stripe Checkout/portal return URLs). Falls back to https://www.folkets-meninger.no
NEXT_PUBLIC_APP_URL=https://www.folkets-meninger.no

# Delbare Ja / Vet ikke / Nei-avstemninger (/del + /embed + OG-bilder).
# Default false: pages 404 and the Del button is hidden for everyone except admins.
SHARE_POLLS_ENABLED=false

# Stripe (Vercel Marketplace → Stripe). Checkout stays honestly unconfigured until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STEMME_PLUS_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
