{
  "id": "folkets-document-embeddings",
  "name": "Folkets Meninger – dokument embeddings (RAG)",
  "nodes": [
    {
      "id": "a1857773-2ac8-4274-952e-8ca433171094",
      "name": "Every 60 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "ba0b4c00-2e67-495a-bf6c-f1098ccbbfcd",
      "name": "Embedding settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "8",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "86e75435-9bb4-4915-ae1e-9d6ddf35a26c",
      "name": "Fetch pending chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://supabase.heyklever.app/rest/v1/rpc/n8n_list_pending_document_chunks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_issue_id: $json.issueId || null, p_limit: Number($json.batchLimit || 8) }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {},
      "retryOnFail": true
    },
    {
      "id": "6df93885-ca8f-4619-90bd-f897ad047116",
      "name": "Expand pending chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const raw = $input.first()?.json;\nlet rows = [];\nif (Array.isArray(raw)) rows = raw;\nelse if (Array.isArray(raw?.data)) rows = raw.data;\nelse if (raw && typeof raw === 'object' && (raw.id || raw.issue_id) && !raw.skip) rows = [raw];\nelse {\n  const all = $input.all().map((i) => i.json).filter(Boolean);\n  if (all.length && all.every((r) => r && (r.id || r.issue_id) && !Array.isArray(r))) rows = all;\n}\nrows = rows.filter((r) => r && (r.id || r.issue_id) && !r.skip && !r.outcome);\nif (!rows.length) return [];\nreturn rows.map((r) => ({ json: r }));"
      }
    },
    {
      "id": "6727b502-2ccc-4834-bbc7-a7afe21afff8",
      "name": "Has pending chunk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "looseTypeValidation": true,
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-id",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "47df60ea-8c1c-4932-b22c-d68e9aaf01ff",
      "name": "Ollama embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"nomic-embed-text:v1.5\",\"prompt\":{{ JSON.stringify($json.content) }}}",
        "options": {
          "timeout": 120000
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "73abc0f4-03f9-4343-9dd9-083215e645b3",
      "name": "Map embedding vector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const chunk = $('Expand pending chunks').item.json;\nconst response = $input.item.json;\nconst embedding = response.embedding;\nif (!Array.isArray(embedding) || embedding.length === 0) {\n  return {\n    json: {\n      ...chunk,\n      skip: true,\n      outcome: 'embed_failed',\n      reason: 'missing_embedding_vector',\n      message: 'Ollama returned no embedding; chunk left pending for /api/cron/n8n-retry',\n    },\n  };\n}\nreturn { json: { ...chunk, embedding } };"
      }
    },
    {
      "id": "487825e5-4279-4590-b7d4-3d2d79b37ea6",
      "name": "Prepare embedding update SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const item = $input.item.json;\nif (item.skip || item.outcome === 'embed_failed' || item.outcome === 'empty_queue') {\n  return { json: item };\n}\nconst embedding = item.embedding;\nif (!Array.isArray(embedding) || embedding.length === 0) {\n  return {\n    json: {\n      ...item,\n      skip: true,\n      outcome: 'embed_failed',\n      reason: 'missing_embedding_vector',\n    },\n  };\n}\nreturn {\n  json: {\n    ...item,\n    embedding_vector: '[' + embedding.join(',') + ']',\n  },\n};"
      }
    },
    {
      "id": "055553a1-3b9f-4d04-8ac6-b660b7646cb8",
      "name": "Has embedding vector?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1700,
        300
      ],
      "parameters": {
        "looseTypeValidation": true,
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-vec",
              "leftValue": "={{ $json.embedding_vector }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ]
        }
      }
    },
    {
      "id": "e788f7d0-8319-4c22-9274-7c80025fd52b",
      "name": "Save embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://supabase.heyklever.app/rest/v1/rpc/n8n_save_document_embedding",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_chunk_id: $json.id, p_embedding: $json.embedding_vector }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {},
      "retryOnFail": true
    },
    {
      "id": "948d7aed-62df-4c0b-9ab0-1ff35444dda4",
      "name": "Clear document body storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://supabase.heyklever.app/rest/v1/rpc/n8n_finalize_document_storage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_issue_id: $('Prepare embedding update SQL').item.json.issue_id, p_document_id: $('Prepare embedding update SQL').item.json.document_id }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {},
      "onError": "continueRegularOutput"
    },
    {
      "id": "6524b4a8-2cc1-4ddc-9b90-d0465d7e4b55",
      "name": "Collect ready issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ids = new Set();\ntry {\n  for (const item of $('Prepare embedding update SQL').all()) {\n    const issueId = String(item.json?.issue_id || '').trim();\n    if (issueId && !item.json?.skip) ids.add(issueId);\n  }\n} catch (_) {\n  for (const item of $input.all()) {\n    const issueId = String(item.json?.issue_id || '').trim();\n    if (issueId) ids.add(issueId);\n  }\n}\nif (!ids.size) return [];\nreturn [...ids].map((stortinget_issue_id) => ({ json: { stortinget_issue_id } }));"
      }
    },
    {
      "id": "fc54e3bc-3921-4820-aff0-b761fa50241d",
      "name": "Trigger AI summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://n8n.heyklever.app/webhook/folkets-ai-summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stortinget_issue_id: $json.stortinget_issue_id }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {},
      "onError": "continueRegularOutput"
    },
    {
      "id": "6c4abd33-de5b-4147-ad8a-482495e43a41",
      "name": "Rate limit pause",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2700,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "0829337a-914a-49c2-96ec-e6cbb5981111",
      "name": "Batch run complete",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2900,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "status",
              "value": "embedding_batch_complete",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "f501dbb9-1fe9-483b-9a4c-75470056b032",
      "name": "Log embed failure keep pending",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1900,
        450
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "outcome",
              "name": "outcome",
              "value": "embed_failed",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "Embedding failed; chunk remains pending for next run",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "7f64fa4b-0309-4ab8-95c9-edc1ebf8d4e4",
      "name": "Log empty embedding queue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        450
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "outcome",
              "name": "outcome",
              "value": "empty_queue",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "No pending document_chunks to embed",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "4466f2cf-be5e-4851-8aa0-b41d53f06804",
      "name": "Webhook document embeddings",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        450
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "folkets-document-embeddings",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "webhookId": "06d7aba1-daf8-401d-9196-38d097b8bcd5"
    },
    {
      "id": "49646afb-3b69-4cca-a99d-18f2f4f5348d",
      "name": "Normalize webhook payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        450
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "batch-limit",
              "name": "batchLimit",
              "value": "12",
              "type": "string"
            },
            {
              "id": "issue-id",
              "name": "issueId",
              "value": "={{ $json.body?.stortinget_issue_id || $json.stortinget_issue_id || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "7a34738f-10ca-4fc6-af76-292fdc69e9ff",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        600
      ],
      "parameters": {}
    },
    {
      "id": "a434d7c2-d4e0-42af-b0af-f6928f021dc8",
      "name": "Format workflow error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first()?.json || {};\nconst workflowName = item.workflow?.name || item.workflowName || 'ukjent workflow';\nconst workflowId = item.workflow?.id || item.workflowId || '';\nconst executionId = item.execution?.id || item.executionId || '';\nconst executionUrl = item.execution?.url || (executionId ? ('https://n8n.heyklever.app/execution/' + executionId) : '');\nconst lastNode = item.lastNodeExecuted || item.node?.name || '';\nconst message = item.error?.message || item.message || 'Ukjent feil';\nconst subject = 'n8n-feil: ' + workflowName;\nconst text = [\n  'Workflow: ' + workflowName,\n  workflowId ? 'ID: ' + workflowId : null,\n  lastNode ? 'Siste node: ' + lastNode : null,\n  executionUrl ? 'Kjøring: ' + executionUrl : null,\n  '',\n  message,\n].filter(Boolean).join('\\n');\nreturn [{ json: { subject, text, meta: { workflowName, workflowId, executionId, executionUrl, lastNode } } }];"
      }
    },
    {
      "id": "526c194e-2de0-4fc9-afc8-52ac764f5eaf",
      "name": "Error notify settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        600
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "cron-secret",
              "name": "cronSecret",
              "type": "string",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "id": "32813e8c-c71a-4d3e-a701-bfc1d0246bd9",
      "name": "Varsle admin om feil",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        600
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.folkets-meninger.no/api/ops/n8n-notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-cron-secret",
              "value": "={{ $('Error notify settings').item.json.cronSecret }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kind: \"error\", subject: $(\"Format workflow error\").item.json.subject, text: $(\"Format workflow error\").item.json.text, meta: $(\"Format workflow error\").item.json.meta }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
